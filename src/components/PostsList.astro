---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

interface Props {
  limit?: number;
  showHeader?: boolean;
  headerLabel?: string;
  headerTitle?: string;
}

const {
  limit,
  showHeader = true,
  headerLabel = '// Writing',
  headerTitle = 'Recent Writing',
} = Astro.props;

const all = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = limit ? all.slice(0, limit) : all;

const Wrapper = showHeader ? Section : 'section';
const wrapperProps = showHeader
  ? { label: headerLabel, title: headerTitle }
  : { class: 'section' };
---

<Wrapper {...wrapperProps}>
  <div class="posts-list">
    {posts.map((post) => {
      const firstTag = post.data.tags?.[0];
      const dateLabel = post.data.date.toLocaleDateString('en-US', {
        month: 'short',
        year: 'numeric',
      });
      return (
        <a class="post-row" href={`/blog/${post.id}/`}>
          <div class="post-date">{dateLabel}</div>
          <div class="post-title">{post.data.title}</div>
          {firstTag && <span class="post-tag">{firstTag}</span>}
        </a>
      );
    })}
  </div>
</Wrapper>
