---
interface Props {
  tag: string;
  name: string;
  desc: string;
  stack?: string[];
  href?: string;
  docsHref?: string;
}

const { tag, name, desc, stack = [], href, docsHref } = Astro.props;

// Whole card is clickable via a stretched cover anchor — points to docs
// when available, otherwise the repo. The explicit Code/Docs buttons
// inside the card sit above the cover via z-index, so each intercepts
// its own clicks.
const coverHref = docsHref ?? href;
const isExternal = (url?: string) => url?.startsWith('http');
const coverLabel = docsHref
  ? `Open ${name} documentation`
  : `Open ${name} on GitHub`;
---

<div class="project-card">
  {coverHref && (
    <a
      class="project-card-cover"
      href={coverHref}
      target={isExternal(coverHref) ? '_blank' : undefined}
      rel={isExternal(coverHref) ? 'noopener' : undefined}
      aria-label={coverLabel}
    ></a>
  )}

  <div class="project-tag">{tag}</div>
  <div class="project-name">{name}</div>
  <p class="project-desc">{desc}</p>

  {stack.length > 0 && (
    <div class="project-stack">
      {stack.map((item) => <span class="stack-pill">{item}</span>)}
    </div>
  )}

  {(href || docsHref) && (
    <div class="project-links">
      {href && (
        <a
          class="project-link"
          href={href}
          target={isExternal(href) ? '_blank' : undefined}
          rel={isExternal(href) ? 'noopener' : undefined}
        >
          Code ↗
        </a>
      )}
      {docsHref && (
        <a
          class="project-link"
          href={docsHref}
          target={isExternal(docsHref) ? '_blank' : undefined}
          rel={isExternal(docsHref) ? 'noopener' : undefined}
        >
          Docs ↗
        </a>
      )}
    </div>
  )}
</div>
