---
interface Props {
  tag: string;
  name: string;
  desc: string;
  stack?: string[];
  href?: string;
  docsHref?: string;
}

const { tag, name, desc, stack = [], href, docsHref } = Astro.props;

const hasMultipleLinks = Boolean(href && docsHref);

// When the card has both repo + docs links, render as a <div> with an
// invisible "cover" anchor stretched across the whole card pointing to
// the docs URL (preferred destination for visitors). The Code/Docs
// buttons inside the card sit on top of the cover via z-index, so each
// intercepts its own clicks. When only one link exists, the card itself
// becomes the <a>.
const Tag = hasMultipleLinks ? 'div' : href ? 'a' : 'div';
const cardHref = hasMultipleLinks ? undefined : href;
const isExternal = (url?: string) => url?.startsWith('http');
---

<Tag
  class="project-card"
  href={cardHref}
  target={isExternal(cardHref) ? '_blank' : undefined}
  rel={isExternal(cardHref) ? 'noopener' : undefined}
>
  {hasMultipleLinks && docsHref && (
    <a
      class="project-card-cover"
      href={docsHref}
      target={isExternal(docsHref) ? '_blank' : undefined}
      rel={isExternal(docsHref) ? 'noopener' : undefined}
      aria-label={`Open ${name} documentation`}
    ></a>
  )}

  <div class="project-tag">{tag}</div>
  <div class="project-name">{name}</div>
  <p class="project-desc">{desc}</p>

  {stack.length > 0 && (
    <div class="project-stack">
      {stack.map((item) => <span class="stack-pill">{item}</span>)}
    </div>
  )}

  {hasMultipleLinks && (
    <div class="project-links">
      {href && (
        <a
          class="project-link"
          href={href}
          target={isExternal(href) ? '_blank' : undefined}
          rel={isExternal(href) ? 'noopener' : undefined}
        >
          Code ↗
        </a>
      )}
      {docsHref && (
        <a
          class="project-link"
          href={docsHref}
          target={isExternal(docsHref) ? '_blank' : undefined}
          rel={isExternal(docsHref) ? 'noopener' : undefined}
        >
          Docs ↗
        </a>
      )}
    </div>
  )}

  {!hasMultipleLinks && href && <span class="project-arrow" aria-hidden="true">↗</span>}
</Tag>
