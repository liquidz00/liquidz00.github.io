---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import Section from '../../components/Section.astro';
---

<BaseLayout title="Projects | Liquid Zoo">
  <main class="page">
    <Section
      label="// Projects"
      title="Open-source work"
      as="h1"
      class="page-intro"
    >
      <p class="prose">
        A snapshot of what I build, maintain, and lean on every day. The list
        skews toward MacAdmin tooling, Jamf integrations, and Python — that's
        where I spend most of my open-source time.
      </p>
    </Section>

    <Section label="// Authored" title="Projects I've built">
      <ProjectsGrid category="authored" />
    </Section>

    <Section label="// Maintain & contribute" title="Community open source">
      <ProjectsGrid category="contribute" />
    </Section>

    <Section label="// Daily drivers" title="Tools I lean on">
      <p class="prose">
        Foundational MacAdmin tools that show up in my day-to-day work — not
        my code, but my workflow wouldn't function without them.
      </p>
      <ul class="daily-drivers">
        <li>
          <a href="https://github.com/Installomator/Installomator" target="_blank" rel="noopener">
            <strong>Installomator</strong>
          </a>
          — install the latest version of Mac apps from their original developer with a single shell command.
        </li>
        <li>
          <a href="https://sofa.macadmins.io/" target="_blank" rel="noopener">
            <strong>SOFA</strong>
          </a>
          — Simple Organized Feed for Apple software updates. The MacAdmins community's source of truth for OS release timing.
        </li>
      </ul>
    </Section>
  </main>
</BaseLayout>
