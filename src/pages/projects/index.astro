---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectsGrid from '../../components/ProjectsGrid.astro';
import Section from '../../components/Section.astro';
---

<BaseLayout title="Projects | Liquid Zoo">
  <main class="page">
    <Section
      label="// Projects"
      title="Open-source work"
      as="h1"
      class="page-intro"
    >
      <p class="prose">
        Tools I build and maintain for the MacAdmin community. Each project
        ships with documentation on Read the Docs and source on GitHub.
      </p>
    </Section>

    <ProjectsGrid showHeader={false} />
  </main>
</BaseLayout>
