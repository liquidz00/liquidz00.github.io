---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks | Liquid Zoo"
  description="Thanks for reaching out — your message is on its way."
>
  <main class="page message-page">
    <div class="message-eyebrow">// Thanks</div>
    <h1 class="message-title">Message received.</h1>
    <p class="message-body">
      Appreciate you reaching out — I'll get back to you as soon as I can.
      Until then, feel free to keep poking around.
    </p>
    <div class="message-actions">
      <a href="/" class="btn-primary">Go home ↗</a>
      <a href="/blog/" class="btn-ghost">Read the blog</a>
      <a href="/about/" class="btn-ghost">Back to About</a>
    </div>
  </main>
</BaseLayout>
