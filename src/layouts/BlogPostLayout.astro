---
import BaseLayout from './BaseLayout.astro';

const { post, newer, older } = Astro.props;
const description =
  post.data.description ??
  `${post.data.title} — writing by Andrew Speciale (spesh).`;
const heroFit = post.data.heroFit ?? 'cover';

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });
---

<BaseLayout title={`${post.data.title} | Liquid Zoo`} description={description}>
  <main class="page">
    <article class="blog-post">
      <header class="blog-post-header">
        <div class="blog-post-meta">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          {post.data.updated && (
            <>
              <span class="blog-post-meta-sep" aria-hidden="true">·</span>
              <time datetime={post.data.updated.toISOString()}>
                Updated {formatDate(post.data.updated)}
              </time>
            </>
          )}
        </div>

        <h1>{post.data.title}</h1>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="blog-post-tags">
            {post.data.tags.map((t: string) => (
              <span class="post-tag">{t}</span>
            ))}
          </div>
        )}
      </header>

      <div class="blog-post-body" data-hero-fit={heroFit}>
        <slot />
      </div>

      {(older || newer) && (
        <nav class="blog-post-nav" aria-label="More posts">
          {older ? (
            <a class="blog-post-nav-link blog-post-nav-older" href={`/blog/${older.id}/`}>
              <span class="blog-post-nav-direction">← Older post</span>
              <span class="blog-post-nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="blog-post-nav-spacer" aria-hidden="true"></span>
          )}
          {newer ? (
            <a class="blog-post-nav-link blog-post-nav-newer" href={`/blog/${newer.id}/`}>
              <span class="blog-post-nav-direction">Newer post →</span>
              <span class="blog-post-nav-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="blog-post-nav-spacer" aria-hidden="true"></span>
          )}
        </nav>
      )}
    </article>
  </main>
</BaseLayout>
